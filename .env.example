# API Keys for AI Services
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Configuration
AI_PROVIDER=openai  # Options: openai, anthropic
MODEL_NAME=gpt-4  # For OpenAI: gpt-4, gpt-3.5-turbo | For Anthropic: claude-3-opus-20240229
OVERLAY_OPACITY=0.85
HOTKEY_CAPTURE=<ctrl>+<shift>+c
HOTKEY_TOGGLE=<ctrl>+<shift>+h
MEMORY_FILE=interview_memory.json
